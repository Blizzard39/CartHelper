{
  "schemaVersion": 1,
  "id": "cart-helper",
  "version": "${version}",
  "name": "Cart Helper",
  "description": "This is an example description! Tell everyone what your mod is about!",
  "authors": [
    "Me!"
  ],
  "contact": {
    "homepage": "https://github.com/Blizzard39/CartHelper",
    "sources": "https://github.com/Blizzard39/CartHelper",
    "issues": "https://github.com/Blizzard39/CartHelper/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/cart-helper/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.blizzard39.carthelper.CartHelper"
    ],
    "client": [
      "io.github.blizzard39.carthelper.client.CartHelperClient"
    ],
    "modmenu": [
      "io.github.blizzard39.carthelper.client.CartHelperModMenu"
    ]
  },
  "mixins": [
    "cart-helper.mixins.json",
    {
      "config": "cart-helper.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
